import { Button, CheckBox, ComboBox, LineEdit, Slider, ScrollView, TabWidget, TextEdit, ProgressIndicator } from "std-widgets.slint";
export { Strings } from "strings.slint";
import { Strings } from "strings.slint";

export struct Controls {
    processing: bool, noise: int, high-pass: bool, agc: bool, adaptive: bool,
    bitrate: string, ptime: int, capture-quality: int, render-quality: int,
    output-rate: string, jitter: string, sources: string, silent: string, source-gain: string,
    admission: string, fade: string, source-ceiling: string, master-ceiling: string,
    lookahead: string, attack: string, release: string, headroom: string,
    input-bytes: string, pcm-samples: string,
}
export struct BudgetFailure { active: bool, required: string, limit: string, seconds: string, rate: string, channels: string }
export struct StageRow { name: string, state: string, applied: bool }
component Field inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> value;
    in property <bool> active: true;
    spacing: 12px;
    Text { text: root.label; width: 190px; color: #555e64; vertical-alignment: center; }
    LineEdit { text <=> root.value; enabled: root.active; }
}
component Heading inherits Text { font-size: 15px; font-weight: 600; color: #18262c; }
export component Workbench inherits Window {
    title: @tr("AudioKit / Test Workbench");
    preferred-width: 1120px; preferred-height: 900px;
    min-width: 720px; min-height: 700px;
    background: #f5f7f8; default-font-size: 14px;
    in-out property <int> scenario;
    in-out property <int> profile;
    in-out property <int> language;
    in-out property <Controls> controls;
    in-out property <string> input-path;
    in-out property <string> output-base;
    in-out property <bool> retain-input;
    in-out property <bool> profiling;
    in-out property <float> volume;
    in-out property <string> preset-json;
    in property <[string]> output-devices;
    in property <[string]> input-devices;
    in-out property <int> input-device;
    in-out property <string> record-seconds;
    in property <bool> recording;
    in property <string> material-evidence;
    in-out property <int> output-device;
    in-out property <int> panel-index;
    in-out property <int> result-index;
    in-out property <length> scroll-position;
    in property <bool> busy;
    in property <bool> has-result;
    in property <bool> playable;
    in property <bool> failed;
    in property <float> progress;
    in property <string> status: @tr("Ready");
    in property <string> status-prefix;
    in property <string> status-detail;
    in property <BudgetFailure> budget-failure;
    in property <string> coverage: @tr("Offline");
    in property <string> peak: "--";
    in property <string> clamps: "--";
    in property <string> gaps: "--";
    in property <string> cpu: "--";
    in property <string> result-run;
    in property <string> result-state;
    in property <string> result-rate;
    in property <string> result-channels;
    in property <bool> result-retained;
    in property <string> result-drops;
    in property <string> result-path;
    in property <string> evidence;
    in property <string> latency;
    in property <string> checks;
    in property <[StageRow]> stages;
    callback choose-input(); callback choose-output(); callback select-profile();
    callback reset(); callback load-preset(); callback save-preset(); callback apply-json();
    callback validate(); callback execute(); callback cancel(); callback load-result();
    callback export-bundle(); callback export-wav(); callback preview();
    callback sync-json(); callback refresh-outputs();
    callback language-changed();
    callback record(); callback finish-recording();
    VerticalLayout {
        padding: 20px; spacing: 14px;
        HorizontalLayout {
            spacing: 16px; height: 36px;
            Text { text: "AudioKit"; font-size: 24px; font-weight: 700; color: #18262c; vertical-alignment: center; }
            Text { text: @tr("TEST WORKBENCH"); color: #68767f; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: Strings.translate(root.coverage); color: #287269; vertical-alignment: center; wrap: word-wrap; }
        }
        HorizontalLayout {
            spacing: 10px; height: 36px;
            ComboBox { enabled: !root.busy; model: [@tr("Capture PCM"), @tr("Opus roundtrip"), @tr("Multi-source render"), @tr("Packet replay")]; current-index <=> root.scenario; selected(value) => { root.select-profile(); } }
            ComboBox { enabled: !root.busy; model: [@tr("Voice / mono"), @tr("Desktop / stereo")]; current-index <=> root.profile; selected(value) => { root.select-profile(); } }
        }
        HorizontalLayout {
            spacing: 10px; height: 36px;
            ComboBox { width: 140px; model: ["简体中文", "English"]; current-index <=> root.language; selected(value) => { root.language-changed(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Load preset"); enabled: !root.busy; clicked => { root.load-preset(); } }
            Button { text: @tr("Save preset"); enabled: !root.busy; clicked => { root.save-preset(); } }
            Button { text: @tr("Reset"); enabled: !root.busy; clicked => { root.reset(); } }
        }
        ScrollView {
            content-y <=> root.scroll-position;
            VerticalLayout {
                padding-right: 12px; spacing: 14px;
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: root.scenario == 3 ? @tr("Packet JSON") : @tr("Input WAV"); width: 95px; vertical-alignment: center; }
                    LineEdit { text <=> root.input-path; enabled: !root.busy; }
                    Button { text: @tr("Browse"); enabled: !root.busy; clicked => { root.choose-input(); } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: @tr("Input device"); width: 95px; vertical-alignment: center; }
                    ComboBox { model: root.input-devices; current-index <=> root.input-device; enabled: !root.busy; }
                    Button {
                        width: 36px; height: 36px; icon: @image-url("icons/refresh-cw.svg"); colorize-icon: true;
                        accessible-label: @tr("Refresh audio devices");
                        enabled: !root.busy; clicked => { root.refresh-outputs(); }
                        Tooltip { text: @markdown("\{ @tr("Refresh audio devices") }"); }
                    }
                    Text { text: @tr("Recording duration (s)"); vertical-alignment: center; }
                    LineEdit { text <=> root.record-seconds; width: 55px; enabled: !root.busy; }
                    Button { text: @tr("Record"); enabled: !root.busy && root.scenario != 3; clicked => { root.record(); } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: @tr("Output folder"); width: 95px; vertical-alignment: center; }
                    LineEdit { text <=> root.output-base; enabled: !root.busy; }
                    Button { text: @tr("Browse"); enabled: !root.busy; clicked => { root.choose-output(); } }
                }
                HorizontalLayout {
                    spacing: 20px;
                    CheckBox { text: @tr("Include original audio / payloads"); checked <=> root.retain-input; enabled: !root.busy; }
                    CheckBox { text: @tr("CPU profiling"); checked <=> root.profiling; enabled: !root.busy; }
                    Rectangle { horizontal-stretch: 1; }
                }
                TabWidget {
                    height: 310px;
                    current-index <=> root.panel-index;
                    Tab {
                        title: @tr("Capture");
                        VerticalLayout {
                            padding: 16px; spacing: 10px;
                            HorizontalLayout {
                                CheckBox { text: @tr("Voice processing"); checked <=> root.controls.processing; enabled: !root.busy && root.profile == 0 && root.scenario < 2; }
                                CheckBox { text: @tr("High-pass"); checked <=> root.controls.high-pass; enabled: !root.busy && root.controls.processing && root.scenario < 2; }
                                CheckBox { text: @tr("AGC2"); checked <=> root.controls.agc; enabled: !root.busy && root.controls.processing && root.scenario < 2; }
                                CheckBox { text: @tr("Adaptive gain"); checked <=> root.controls.adaptive; enabled: !root.busy && root.controls.processing && root.controls.agc && root.scenario < 2; }
                            }
                            HorizontalLayout {
                                Text { text: @tr("Noise suppression"); width: 190px; vertical-alignment: center; }
                                ComboBox { model: [@tr("Off"), @tr("Low"), @tr("Moderate"), @tr("High"), @tr("Very high")]; current-index <=> root.controls.noise; enabled: !root.busy && root.controls.processing && root.scenario < 2; }
                            }
                            HorizontalLayout {
                                Text { text: @tr("Capture resampler"); width: 190px; vertical-alignment: center; }
                                ComboBox { model: [@tr("Balanced"), @tr("High quality")]; current-index <=> root.controls.capture-quality; enabled: !root.busy && root.scenario != 3; }
                            }
                            Text { text: @tr("AEC: unavailable / no aligned playback reference"); color: #8a6422; wrap: word-wrap; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Tab {
                        title: @tr("Codec");
                        VerticalLayout {
                            padding: 16px; spacing: 12px;
                            Field { label: @tr("Target bitrate (bit/s)"); value <=> root.controls.bitrate; active: !root.busy && root.scenario == 1; }
                            HorizontalLayout {
                                Text { text: @tr("Packet duration (ms)"); width: 190px; vertical-alignment: center; }
                                ComboBox { model: ["10", "20", "40", "60"]; current-index <=> root.controls.ptime; enabled: !root.busy && root.scenario == 1; }
                            }
                            Field { label: @tr("Jitter startup (ms)"); value <=> root.controls.jitter; active: !root.busy && (root.scenario == 1 || root.scenario == 3); }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Tab {
                        title: @tr("Render");
                        VerticalLayout {
                            padding: 12px; spacing: 3px;
                            Field { label: @tr("Output sample rate (Hz)"); value <=> root.controls.output-rate; active: !root.busy && root.scenario != 0; }
                            HorizontalLayout {
                                Text { text: @tr("Render resampler"); width: 190px; vertical-alignment: center; }
                                ComboBox { model: [@tr("Balanced"), @tr("High quality")]; current-index <=> root.controls.render-quality; enabled: !root.busy && root.scenario != 0; }
                            }
                            Field { label: @tr("Source admission limit"); value <=> root.controls.admission; active: !root.busy && root.scenario != 0; }
                            Field { label: @tr("Gain fade (ms)"); value <=> root.controls.fade; active: !root.busy && root.scenario != 0; }
                            Field { label: @tr("Sources / render stress"); value <=> root.controls.sources; active: !root.busy && root.scenario == 2; }
                            Field { label: @tr("Silent sources"); value <=> root.controls.silent; active: !root.busy && root.scenario == 2; }
                            Field { label: @tr("Source gain (linear)"); value <=> root.controls.source-gain; active: !root.busy && root.scenario == 2; }
                        }
                    }
                    Tab {
                        title: @tr("Protection");
                        VerticalLayout {
                            padding: 12px; spacing: 3px;
                            Field { label: @tr("Source ceiling (dBFS)"); value <=> root.controls.source-ceiling; active: !root.busy && root.scenario != 0; }
                            Field { label: @tr("Master ceiling (dBFS)"); value <=> root.controls.master-ceiling; active: !root.busy && root.scenario != 0; }
                            Field { label: @tr("Master lookahead (ms)"); value <=> root.controls.lookahead; active: !root.busy && root.scenario != 0; }
                            Field { label: @tr("Master attack (ms)"); value <=> root.controls.attack; active: !root.busy && root.scenario != 0; }
                            Field { label: @tr("Master release (ms)"); value <=> root.controls.release; active: !root.busy && root.scenario != 0; }
                            Field { label: @tr("Master headroom (dB)"); value <=> root.controls.headroom; active: !root.busy && root.scenario != 0; }
                        }
                    }
                    Tab {
                        title: @tr("Resources");
                        VerticalLayout {
                            padding: 16px; spacing: 12px;
                            Field { label: @tr("Input byte budget"); value <=> root.controls.input-bytes; active: !root.busy; }
                            Field { label: @tr("PCM sample budget"); value <=> root.controls.pcm-samples; active: !root.busy; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Tab {
                        title: @tr("Advanced JSON");
                        VerticalLayout {
                            padding: 12px; spacing: 8px;
                            TextEdit { text <=> root.preset-json; enabled: !root.busy; font-family: "Consolas"; }
                            HorizontalLayout {
                                Button { text: @tr("Sync from controls"); enabled: !root.busy; clicked => { root.sync-json(); } }
                                Button { text: @tr("Apply JSON"); enabled: !root.busy; clicked => { root.apply-json(); } }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: #dce2e5; }
                Heading { text: @tr("Run diagnostics"); }
                GridLayout {
                    spacing: 12px;
                    Row {
                        Text { text: @tr("Output peak"); color: #68767f; } Text { text: Strings.translate(root.peak); }
                        Text { text: @tr("Safety clamps"); color: #68767f; } Text { text: Strings.translate(root.clamps); }
                    }
                    Row {
                        Text { text: @tr("Missing frames"); color: #68767f; } Text { text: Strings.translate(root.gaps); }
                        Text { text: @tr("Worker overruns"); color: #68767f; } Text { text: Strings.translate(root.cpu); }
                    }
                }
                Text { text: root.has-result ? Strings.summary(root.result-run, root.result-state, root.result-rate, root.result-channels, root.result-retained, root.result-drops, root.result-path) : ""; wrap: word-wrap; color: #68767f; }
                TabWidget {
                    height: 230px;
                    current-index <=> root.result-index;
                    Tab { title: @tr("Coverage");
                        ScrollView { VerticalLayout {
                            padding: 12px; spacing: 4px;
                            for stage in root.stages: HorizontalLayout {
                                height: 26px; spacing: 12px;
                                Text { text: Strings.translate(stage.name); color: #273b43; }
                                Text { text: Strings.translate(stage.state); color: stage.applied ? #287269 : #677681; }
                            }
                        } }
                    }
                    Tab { title: @tr("Checks"); TextEdit { text: root.checks; read-only: true; } }
                    Tab { title: @tr("Latency"); TextEdit { text: root.latency; read-only: true; font-family: "Consolas"; } }
                    Tab { title: @tr("Evidence"); TextEdit { text: root.evidence; read-only: true; font-family: "Consolas"; } }
                    Tab { title: @tr("Material capture"); TextEdit { text: root.material-evidence; read-only: true; font-family: "Consolas"; } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Button { text: @tr("Load result"); enabled: !root.busy; clicked => { root.load-result(); } }
                    Button { text: @tr("Export bundle"); enabled: !root.busy && root.has-result; clicked => { root.export-bundle(); } }
                    Button { text: @tr("Export WAV"); enabled: !root.busy && root.has-result; clicked => { root.export-wav(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    ComboBox { model: root.output-devices; current-index <=> root.output-device; enabled: !root.busy; }
                    Button {
                        width: 36px; height: 36px; icon: @image-url("icons/refresh-cw.svg"); colorize-icon: true;
                        accessible-label: @tr("Refresh audio devices");
                        enabled: !root.busy; clicked => { root.refresh-outputs(); }
                        Tooltip { text: @markdown("\{ @tr("Refresh audio devices") }"); }
                    }
                    Button {
                        width: 36px; height: 36px; icon: @image-url("icons/play.svg"); colorize-icon: true;
                        accessible-label: @tr("Play processed WAV");
                        enabled: !root.busy && root.playable; clicked => { root.preview(); }
                        Tooltip { text: @markdown("\{ @tr("Play processed WAV") }"); }
                    }
                    Text { text: @tr("Volume"); vertical-alignment: center; }
                    Slider { minimum: 0; maximum: 1; value <=> root.volume; enabled: !root.busy; }
                }
            }
        }
        HorizontalLayout {
            spacing: 10px; height: 36px;
            Button { text: @tr("Validate"); enabled: !root.busy; clicked => { root.validate(); } }
            Button { text: @tr("Run"); enabled: !root.busy; clicked => { root.execute(); } }
            Button { text: @tr("Finish recording"); enabled: root.busy && root.recording; clicked => { root.finish-recording(); } }
            Button { text: @tr("Cancel"); enabled: root.busy; clicked => { root.cancel(); } }
            ProgressIndicator { progress: root.progress; horizontal-stretch: 1; }
        }
        Text { text: root.budget-failure.active ? Strings.sample-budget(root.budget-failure.required, root.budget-failure.limit, root.budget-failure.seconds, root.budget-failure.rate, root.budget-failure.channels) : root.status-prefix == "" ? Strings.translate(root.status) : Strings.translate(root.status-prefix) + ": " + Strings.translate(root.status-detail); color: root.failed ? #b63342 : #287269; wrap: word-wrap; }
    }
}
